# Optional backend base URL. Leave empty to use browser-local demo services.
VITE_API_URL=

# "demo" is the only implemented mode. Configure a real provider before using another value.
VITE_AUTH_MODE=demo

# "local" stores citizen reports in this browser. A future API adapter can use "api".
VITE_REPORT_STORAGE=local

# Public browser-safe map configuration. No secret token is required for the default OSM tiles.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Never add database passwords, service-role keys, or private API credentials to VITE_* variables.

