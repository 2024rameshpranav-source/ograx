# ==========================================
# AquaSignal Backend Environment Variables
# ==========================================

# Application
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server & API
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:8443","http://localhost:3000"]

# Machine Learning Model Paths
# Pune is powered by its trained model artifact; Mumbai is powered by the rule-based warning engine
PUNE_MODEL_PATH=backend/app/models/pune_model.joblib

# Database Configuration
# SQLite local fallback (used when MongoDB Atlas is unconfigured or during local tests)
DATABASE_URL=sqlite:///./app/data/aquasignal.db

# MongoDB Atlas Connection String
# Replace <USERNAME>, <PASSWORD>, and <CLUSTER_HOST> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/aquasignal?retryWrites=true&w=majority
MONGODB_DB_NAME=aquasignal
MONGODB_TIMEOUT_MS=5000

